<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared MSBuild settings for the OcelotJS native (ClangCL/MSVC-CRT) build.
  Imported by every .vcxproj in this solution so the ClangCL toolset choice,
  warning suppressions and CONFIG_VERSION macro stay in one place.
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- NOTE: PlatformToolset/WindowsTargetPlatformVersion are deliberately NOT set here.
       This file is imported via ImportGroup Label="PropertySheets", which runs AFTER
       each .vcxproj's own Import of $(VCTargetsPath)\Microsoft.Cpp.props, but that
       import is exactly where MSBuild resolves/validates PlatformToolset (MSB8020
       "build tools cannot be found" if it's unset at that point). Every .vcxproj
       therefore sets PlatformToolset itself, in its own per-config PropertyGroup
       Label="Configuration", before importing Microsoft.Cpp.props. -->
  <PropertyGroup>
    <!-- Mirrors the Makefile's `-DCONFIG_VERSION=\"$(shell cat VERSION)\"`. -->
    <ConfigVersion>"1.0.0"</ConfigVersion>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>false</ConformanceMode>
      <!-- gnu11 (not MSVC's own C11/C17 mode) matches every other build of this
           codebase (make/gcc/clang all use -std=gnu11). The -Wno-* flags silence
           benign clang-cl-only warnings verified harmless against this exact
           source tree (see quickjs-pal.h / Part II plan notes): sign-compare,
           unused-parameter and missing-field-initializers are pre-existing
           style choices shared with the make build's own -Wno- list;
           microsoft-enum-forward-reference and ignored-attributes are clang-cl
           surfacing a legal MS extension and an unrecognized (but harmless)
           gcc/clang-only attribute spelling, neither of which GCC/clang-POSIX
           warn about. -->
      <AdditionalOptions>/clang:-std=gnu11 -Wno-sign-compare -Wno-unused-parameter -Wno-missing-field-initializers -Wno-microsoft-enum-forward-reference -Wno-ignored-attributes %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;CONFIG_VERSION="1.0.0";%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
